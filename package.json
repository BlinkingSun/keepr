{
  "name": "keepr",
  "productName": "KeepR",
  "version": "0.1.0",
  "description": "Offline-first receipt, expense, and document management",
  "private": true,
  "author": "Joshua Roberts",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "abi:check": "electron scripts/abi-check.mjs",
    "abi:check:node": "node scripts/abi-check.mjs",
    "serve": "npm run rebuild:node --silent && node --experimental-strip-types src/main/serve.ts",
    "start": "npm run rebuild:electron --silent && npm run build && electron dist/main/index.js",
    "test": "npm run rebuild:node --silent && node --experimental-strip-types --test \"src/**/__tests__/*.ts\"",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "test:schema": "npm run rebuild:node --silent && node --experimental-strip-types spikes/schema-verify.ts",
    "package:mac": "npm run rebuild:electron --silent && npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.34.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.blinkingsun.keepr",
    "productName": "KeepR",
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/tesseract.js/**",
      "**/node_modules/tesseract.js-core/**",
      "resources/tessdata/**"
    ],
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**/test/**",
      "!node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "resources/tessdata",
        "to": "tessdata"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "extraMetadata": {
      "main": "dist/main/index.js"
    }
  }
}
